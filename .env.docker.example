# Copy this file to .env.docker.local and keep the copy untracked.
# These two values are browser-visible public Supabase configuration, not
# database passwords or service-role credentials. The example is deliberately
# synthetic and provides only unauthenticated application-container proof.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=plave_docker_example_publishable_key
