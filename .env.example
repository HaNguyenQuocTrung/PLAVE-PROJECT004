NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only universal curriculum runtime. Keep false unless an approved
# database has migration 0038 plus a validated ACTIVE local release.
PLAVE_CURRICULUM_RUNTIME_ENABLED=false

# Disposable loopback integration only; never point these at a remote host.
PLAVE_LOCAL_CURRICULUM_ACTIVATE=false
PLAVE_LOCAL_DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:54322/local_database

# AI Tutor is server-only and fails closed unless all required values are set.
# Never prefix provider secrets with NEXT_PUBLIC and never commit .env.local.
PLAVE_AI_TUTOR_ENABLED=false
PLAVE_AI_PROVIDER=GOOGLE
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=
PLAVE_AI_MAX_MESSAGE_CHARACTERS=2000
PLAVE_AI_MAX_HISTORY_TURNS=12
PLAVE_AI_MAX_REQUEST_BYTES=32768
PLAVE_AI_MAX_OUTPUT_TOKENS=4096
PLAVE_AI_REQUESTS_PER_MINUTE=6
PLAVE_AI_DAILY_REQUEST_LIMIT=80
PLAVE_AI_TIMEOUT_MS=30000
