NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only universal curriculum runtime. Keep false unless an approved
# database has migration 0038 plus a validated ACTIVE local release.
PLAVE_CURRICULUM_RUNTIME_ENABLED=false

# Disposable loopback integration only; never point these at a remote host.
PLAVE_LOCAL_CURRICULUM_ACTIVATE=false
PLAVE_LOCAL_DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:54322/local_database
